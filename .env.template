# Your live production domain. This drives canonical URLs, Open Graph tags,
# the sitemap and robots.txt. Code already defaults to this value if the
# variable is unset anywhere, but set it explicitly on your host (Vercel/
# Docker/etc.) so it's never ambiguous.
NEXT_PUBLIC_SITE_URL=https://muhammad-hamza.me

# Google Search Console verification code (required to submit your sitemap
# and request indexing so Google actually crawls the site).
# How to get it:
#   1. Go to https://search.google.com/search-console
#   2. Add property -> "URL prefix" -> https://muhammad-hamza.me
#   3. Choose the "HTML tag" verification method
#   4. It gives you a tag like: <meta name="google-site-verification" content="XXXXXXXX" />
#   5. Copy only the XXXXXXXX value below
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (Bing/Yahoo/DuckDuckGo indexing).
# How to get it:
#   1. Go to https://www.bing.com/webmasters
#   2. Add your site -> https://muhammad-hamza.me
#      (you can also import it directly from Google Search Console)
#   3. Choose the "HTML Meta Tag" verification method
#   4. It gives you a tag like: <meta name="msvalidate.01" content="XXXXXXXX" />
#   5. Copy only the XXXXXXXX value below
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# No secret is required for the contact form.
# It opens the visitor's email client via a mailto: link — nothing to configure.
